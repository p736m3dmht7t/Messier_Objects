# .env file for Messier_Objects script
# BSU Rooftop Observatory
LATITUDE=40.19980556        # Latitude in decimal degrees
LONGITUDE=-85.41136111      # Longitude in decimal degrees (West is negative)
ALTITUDE=304.5              # Altitude in meters above sea level
TIMEZONE=America/New_York   # IANA Time Zone Name (e.g., America/Chicago, America/Denver, America/New_York)
ALTITUDE_LIMIT=30           # Minimum altitude in degrees for visibility calculations
